[safe]
    directory = *
[init]
	defaultBranch = main
[core]
	pager = less -F -X
	editor = vim
	autocrlf = false
	mergeoptions = --no-edit
	excludesfile = *.swp
[pull]
	rebase = true
[push]
	default = simple
[diff]
	tool = vimdiff
[mergetool]
	prompt = false
[merge]
    ff = no
	tool = vimdiff
	conflictstyle = diff3
[alias]
	pl = pull --rebase --recurse-submodules
	st = status
	co = checkout
	ci = commit
	br = branch
	cp = cherry-pick --no-ff -x
    lg1 = log --color --name-status --parents -n 1
    lg  = log --color --graph --oneline --decorate
    lga = log --color --graph --oneline --decorate --all
    lgf = log --color --graph --oneline --decorate --reflog
